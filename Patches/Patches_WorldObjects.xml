<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/WorldObjectDef[defName="Settlement"]/comps</xpath>
		<value>
			<li Class="RimMarket.Away.WorldObjectCompProperties_MarketTown" />
		</value>
	</Operation>

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/WorldObjectDef[defName="Caravan"]/comps</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/WorldObjectDef[defName="Caravan"]/comps</xpath>
			<value>
				<li Class="RimMarket.Away.WorldObjectCompProperties_CaravanStall" />
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/WorldObjectDef[defName="Caravan"]</xpath>
			<value>
				<comps>
					<li Class="RimMarket.Away.WorldObjectCompProperties_CaravanStall" />
				</comps>
			</value>
		</nomatch>
	</Operation>

</Patch>

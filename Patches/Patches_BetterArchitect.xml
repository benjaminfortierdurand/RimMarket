<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Better Architect Menu</li>
		</mods>
		<match Class="PatchOperationSequence">
			<success>Always</success>
			<operations>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/DesignationCategoryDef[defName="RimMarket_Market"]</xpath>
					<value>
						<li Class="BetterArchitect.NestedCategoryExtension">
							<parentCategory>Ferny_World</parentCategory>
						</li>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/DesignationCategoryDef[defName="RimMarket_Market"]/order</xpath>
					<value>
						<order>-1</order>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/DesignationCategoryDef[defName="RimMarket_Market"]/label</xpath>
					<value>
						<label>Market</label>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

</Patch>

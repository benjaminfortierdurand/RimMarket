<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef>
		<defName>RimMarket_Subdued</defName>
		<label>subdued</label>
		<labelNoun>a tackle</labelNoun>
		<description>Pinned to the ground by a market guard and relieved of any stolen goods. Getting back up takes a few hours and most of one's dignity.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.85, 0.75, 0.3)</defaultLabelColor>
		<scenarioCanAdd>false</scenarioCanAdd>
		<isBad>true</isBad>
		<maxSeverity>1.0</maxSeverity>
		<initialSeverity>1.0</initialSeverity>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>7500~10000</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
		<stages>
			<li>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.1</setMax>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>

</Defs>

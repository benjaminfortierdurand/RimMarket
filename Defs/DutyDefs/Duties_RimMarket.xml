<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<DutyDef>
		<defName>RimMarket_TendStall</defName>
		<thinkNode Class="ThinkNode_Priority">
			<subNodes>
				<li Class="RimMarket.AI.JobGiver_PayStallFee" />
				<li Class="RimMarket.Inn.JobGiver_SleepAtInn" />
				<li Class="ThinkNode_ForbidOutsideFlagRadius">
					<maxDistToSquadFlag>10</maxDistToSquadFlag>
					<subNodes>
						<li Class="ThinkNode_Subtree">
							<treeDef>SatisfyBasicNeedsAndWork</treeDef>
						</li>
					</subNodes>
				</li>
				<li Class="RimMarket.AI.JobGiver_StandAtStall" />
				<li Class="JobGiver_WanderNearDutyLocation">
					<wanderRadius>2</wanderRadius>
				</li>
				<li Class="JobGiver_Idle" />
			</subNodes>
		</thinkNode>
	</DutyDef>

